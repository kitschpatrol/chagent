{
	"name": "@kitschpatrol/chagent",
	"version": "0.0.0",
	"description": "Changelog agent. CLI tool and TypeScript library to generate and update changelogs with a little help from your LLMs.",
	"keywords": [
		"changelog",
		"cli",
		"codex",
		"claude",
		"agent",
		"release-notes",
		"typescript"
	],
	"homepage": "https://github.com/kitschpatrol/chagent",
	"bugs": "https://github.com/kitschpatrol/chagent/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/chagent.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		},
		"./bumpp": {
			"types": "./dist/lib/bumpp.d.ts",
			"import": "./dist/lib/bumpp.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"chagent": "dist/bin/cli.js"
	},
	"files": [
		"dist",
		"docs/third-party-notices.md"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "pnpm build && vitest run"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"cosmiconfig": "^10.0.1",
		"cross-spawn": "^7.0.6",
		"lognow": "^0.8.8",
		"semver": "^7.8.6",
		"yaml": "^2.9.1",
		"yargs": "^18.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/semver": "^7.8.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.2",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"tsdown": "^0.23.5",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"bumpp": ">=12.3.0"
	},
	"peerDependenciesMeta": {
		"bumpp": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
